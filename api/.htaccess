<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header across Apache FastCGI / PHP-FPM / DirectAdmin
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    <IfModule mod_authz_core.c>
        CGIPassAuth On
    </IfModule>

    # Prevent direct access to sensitive files and directories
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^phpunit\.xml - [F,L,NC]
    RewriteRule ^database/.*\.sql - [F,L,NC]
    RewriteRule ^(app|bootstrap|bin|database|storage|tests|vendor)/ - [F,L,NC]

    # If domain points to api/ instead of api/public/, forward cleanly with Authorization preserved
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [QSA,E=HTTP_AUTHORIZATION:%{HTTP:Authorization},L]
</IfModule>

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

{
  "name": "whatstheup/api",
  "description": "WhatstheUp REST API",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "phpmailer/phpmailer": "^6.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": { "psr-4": { "WhatstheUp\\": "app/" } },
  "autoload-dev": { "psr-4": { "WhatstheUp\\Tests\\": "tests/" } },
  "scripts": {
    "test": "phpunit",
    "check": ["@php -l public/index.php", "phpunit"]
  },
  "config": { "sort-packages": true, "optimize-autoloader": true }
}
